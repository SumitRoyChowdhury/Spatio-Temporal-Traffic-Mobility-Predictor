generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Sensor {
  sensorId      BigInt                  @id @map("sensor_id")
  metadata      Json
  observations  Observation[]
  configuration SensorConfiguration?
  healthHistory SensorHealthHistory[]
  alerts        SensorAlert[]
  explanations  PredictionExplanation[]

  @@map("sensors")
}

model SensorConfiguration {
  id               BigInt   @id @default(autoincrement())
  sensorId         BigInt   @unique @map("sensor_id")
  expectedInterval Int      @default(300) @map("expected_interval")
  delayedThreshold Int      @default(900) @map("delayed_threshold")
  offlineThreshold Int      @default(1800) @map("offline_threshold")
  freeFlowSpeed    Float    @default(65.0) @map("free_flow_speed")
  roadCategory     String   @default("Freeway") @map("road_category")
  speedUnit        String   @default("mph") @map("speed_unit")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sensor           Sensor   @relation(fields: [sensorId], references: [sensorId], onDelete: Cascade, onUpdate: Cascade)

  @@map("sensor_configurations")
}

model SensorHealthHistory {
  id              BigInt    @id @default(autoincrement())
  sensorId        BigInt    @map("sensor_id")
  status          String
  lastReceivedAt  DateTime? @map("last_received_at") @db.Timestamptz(6)
  checkedAt       DateTime  @default(now()) @map("checked_at") @db.Timestamptz(6)
  dataQuality     Float     @default(100.0) @map("data_quality")
  missingReadings Int       @default(0) @map("missing_readings")
  uptime24h       Float     @default(100.0) @map("uptime_24h")
  uptime7d        Float     @default(100.0) @map("uptime_7d")
  uptime30d       Float     @default(100.0) @map("uptime_30d")
  sensor          Sensor    @relation(fields: [sensorId], references: [sensorId], onDelete: Cascade, onUpdate: Cascade)

  @@index([sensorId, checkedAt])
  @@index([checkedAt])
  @@map("sensor_health_history")
}

model SensorAlert {
  id         BigInt    @id @default(autoincrement())
  sensorId   BigInt    @map("sensor_id")
  alertType  String    @map("alert_type")
  severity   String
  message    String
  isResolved Boolean   @default(false) @map("is_resolved")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  sensor     Sensor    @relation(fields: [sensorId], references: [sensorId], onDelete: Cascade, onUpdate: Cascade)

  @@index([sensorId, isResolved])
  @@index([createdAt])
  @@index([isResolved])
  @@map("sensor_alerts")
}

model Observation {
  sensorId   BigInt   @map("sensor_id")
  observedAt DateTime @map("observed_at") @db.Timestamptz(6)
  speed      Float    @db.DoublePrecision
  flags      Json     @default("[]")
  sourceFile String   @map("source_file")
  sourceRow  BigInt   @map("source_row")
  ingestedAt DateTime @default(now()) @map("ingested_at") @db.Timestamptz(6)
  sensor     Sensor   @relation(fields: [sensorId], references: [sensorId], onDelete: Restrict, onUpdate: Cascade)

  @@id([sensorId, observedAt])
  @@index([observedAt])
  @@map("observations")
}

model QuarantineRecord {
  quarantineId BigInt   @id @default(autoincrement()) @map("quarantine_id")
  sourceFile   String   @map("source_file")
  sourceRow    BigInt   @map("source_row")
  sensorId     BigInt?  @map("sensor_id")
  rawSensorId  String?  @map("raw_sensor_id")
  rawTimestamp String?  @map("raw_timestamp")
  rawSpeed     String?  @map("raw_speed")
  reason       String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([reason])
  @@map("quarantine_records")
}

model PredictionExplanation {
  id                BigInt   @id @default(autoincrement())
  sensorId          BigInt   @map("sensor_id")
  targetTimestamp   DateTime @map("target_timestamp") @db.Timestamptz(6)
  modelName         String   @map("model_name")
  baselineValue     Float    @map("baseline_value")
  predictedValue    Float    @map("predicted_value")
  featureValues     Json     @map("feature_values")
  shapValues        Json     @map("shap_values")
  textExplanation   String   @map("text_explanation")
  explanationMethod String   @default("TreeSHAP") @map("explanation_method")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  sensor            Sensor   @relation(fields: [sensorId], references: [sensorId], onDelete: Cascade, onUpdate: Cascade)

  @@index([sensorId, targetTimestamp])
  @@index([modelName])
  @@index([createdAt])
  @@map("prediction_explanations")
}
